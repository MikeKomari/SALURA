{
  "name": "salura",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @salura/api dev",
    "start": "pnpm --filter @salura/api start",
    "build": "pnpm --filter @salura/web build",
    "start:prod": "pnpm build && pnpm start",
    "db:generate": "pnpm --filter @salura/db generate",
    "db:reset": "pnpm --filter @salura/db reset",
    "eval": "pnpm --filter @salura/eval run eval",
    "check:llm": "tsx --env-file-if-exists=.env packages/agent/src/cli/check-llm.ts",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p apps/web --noEmit",
    "db:migrate": "pnpm --filter @salura/db migrate",
    "build:vercel": "node scripts/build-vercel.mjs",
    "user": "pnpm --filter @salura/api user"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
}
