# --- LLM (any OpenAI-compatible endpoint; default Nous Portal) ---
LLM_BASE_URL=https://inference-api.nousresearch.com/v1
LLM_API_KEY=
# Model id as listed in your Nous Portal account
LLM_MODEL=deepseek/deepseek-v4.1-flash
# native = OpenAI tool_calls; prompt = tools described in the prompt, parsed from <tool_call> blocks.
# Run `pnpm check:llm` once: it tests both and tells you which one your endpoint supports.
LLM_TOOL_MODE=native
# Price per 1M tokens in USD (from your provider's pricing page), for cost-per-order reporting. Blank = cost not reported
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=

# --- Speech-to-text ---
# Two shapes, picked with STT_API:
#   transcriptions = OpenAI-compatible /audio/transcriptions (Groq, OpenAI Whisper, local faster-whisper)
#   chat           = a multimodal chat model that takes audio (Nous Portal has no Whisper endpoint:
#                    its /v1/audio/transcriptions returns 404, so use openai/gpt-audio-mini there).
#                    Only wav and mp3 reach these models; the console converts its recordings to wav,
#                    but a WhatsApp voice note (ogg/opus) needs converting before it arrives.
# Groq (cheap, fast, good at Indonesian):
#   STT_API=transcriptions, STT_BASE_URL=https://api.groq.com/openai/v1, STT_MODEL=whisper-large-v3
# Nous Portal, reusing LLM_API_KEY:
#   STT_API=chat, STT_BASE_URL=https://inference-api.nousresearch.com/v1, STT_MODEL=openai/gpt-audio-mini
STT_API=chat
STT_BASE_URL=https://inference-api.nousresearch.com/v1
STT_API_KEY=
STT_MODEL=openai/gpt-audio-mini

# --- Photo order reading (OpenAI-compatible /chat/completions with a vision-capable model) ---
# Reads photos customers send (order lists, transfer receipts, surat jalan/nota). Any provider that
# accepts image_url data URIs works (Groq, OpenAI, OpenRouter, a local vLLM). Leave blank to use only
# the stored transcripts of the bundled sample photos, as the evaluation does.
VISION_BASE_URL=https://api.groq.com/openai/v1
VISION_API_KEY=
# Example: check your provider's model list for a current vision model id
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Database ---
# Postgres. For Supabase use the pooler URL (IPv4; Vercel and many networks cannot reach the
# IPv6-only direct host): Project → Connect → "Transaction pooler", port 6543, user postgres.<ref>.
# URL-encode special characters in the password (& → %26, * → %2A, @ → %40).
# Blank = an embedded Postgres (PGlite) in ./data/pglite for local runs without a server.
DATABASE_URL=

# --- Accounts ---
# Created on first start when they do not exist yet (8+ characters). Later changes: `pnpm user password admin`.
# Without them, a local run generates passwords and prints them; a production run creates no account.
ADMIN_PASSWORD=
VIEWER_PASSWORD=

# --- App ---
PORT=8787
# Minutes a person takes to enter one order by hand (baseline for "minutes saved")
MANUAL_MINUTES_PER_ORDER=6
# Built console served by the API (pnpm build). Blank = apps/web/dist
WEB_DIST=
# Set to 1 only behind a reverse proxy you control (Railway, Fly, Nginx), so rate limits see the real client IP
TRUST_PROXY=0
# With TRUST_PROXY=1: a header your platform sets to the client IP (fly-client-ip on Fly, cf-connecting-ip on Cloudflare)
CLIENT_IP_HEADER=
# Comma-separated origins allowed to call the API cross-origin. Blank = any (same-origin console needs none)
CORS_ORIGINS=
# Set to off to disable the daily autonomous runs (08:00 WIB reorder offers, 09:00 WIB payment reminders).
# Long-running server only; on Vercel the same runs come from Vercel Cron (see vercel output config).
AGENT_SCHEDULE=on
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"; the cron routes refuse everything without it
CRON_SECRET=
# Public demo: reset the synthetic data after this many minutes without activity (0 = never)
DEMO_RESET_IDLE_MINUTES=0

# --- WhatsApp via OpenWA (optional second channel) ---
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=
